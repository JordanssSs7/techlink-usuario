# Copia este archivo como .env.local (no se sube a Git) y completa los valores.

# URL del backend Spring Boot
VITE_API_URL=http://localhost:8080

# ID de cliente OAuth de Google Cloud Console (tipo "Aplicacion web")
VITE_GOOGLE_CLIENT_ID=

# Solo desarrollo: simula /api/auth/login y /api/auth/google si el backend aun no los tiene
# VITE_MOCK_AUTH=true
